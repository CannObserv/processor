# Processor — the content.process consumer (CannObserv/processor, spec §2–§4).
# Runs the release scripts/deploy.sh put at /srv/processor/live, never a checkout;
# the deploy installs this file from that release (docs/DEPLOYMENT.md).
[Unit]
Description=Processor: consume content.process, extract, store by hash, publish content.derived
Documentation=https://github.com/CannObserv/processor/blob/main/docs/DEPLOYMENT.md
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=exec
# Its own user (#2): no sudo, not in group docker, no home. It reads its release and
# nothing of exedev's; the extraction child is contained besides (spec §3).
User=processor
Group=processor
WorkingDirectory=/srv/processor/live
# CO_PROCESSOR_BUS_URL (the broker credential) and any CO_PROCESSOR_* override.
# root:root 600 in a 700 directory: systemd reads it before switching users, so the
# service user never can. Never sourced into a shell profile.
EnvironmentFile=/etc/processor/.env
# The GCS writer key, root 600 on disk, handed over by systemd at start. Keep
# GOOGLE_APPLICATION_CREDENTIALS out of the env file: EnvironmentFile= overrides
# Environment=.
LoadCredential=gcs-writer-key:/etc/processor/co-gcs-processor-writer.json
Environment=GOOGLE_APPLICATION_CREDENTIALS=%d/gcs-writer-key
# The venv's own entry point: it never syncs, and needs no uv (cohort R5). Its
# scripts carry the release's physical path, so a later switch of the link never
# mixes two releases in one process or its children.
ExecStart=/srv/processor/live/.venv/bin/processor run
Restart=on-failure
RestartSec=5

# Memory (spec §2, §4): a cap below the VM's 8 GB. Each extraction child carries its
# own RLIMIT_AS (3 GiB) and volunteers as the OOM victim (oom_score_adj 1000), so
# the consumer outlives it; OOMPolicy=continue keeps the unit up when that happens
# (the default stops the whole unit on any OOM kill).
MemoryMax=6G
OOMPolicy=continue
OOMScoreAdjust=-500

# SIGTERM lets the in-flight command finish. KillMode=mixed sends it to the consumer
# alone: the default (control-group) signals the extraction child too, killing the
# very command the consumer is draining. The final SIGKILL still reaches every
# process. Budget: the blocking read (5 s), input read (30 s), extraction timeout
# (120 s), store (30 s) and publish (15 s), plus margin; raise it with
# CO_PROCESSOR_EXTRACTION_TIMEOUT_S. That is the healthy-GCS case: under a GCS
# outage the library's own retries can stretch the read and the store to ~150 s
# each (~435 s worst case), and a stop then ends in SIGKILL. That is safe, and kept
# on purpose so a deploy never hangs for minutes: the entry stays pending (nothing
# was acked) and the reclaim re-runs it after reclaim_min_idle_ms.
KillMode=mixed
TimeoutStopSec=240

NoNewPrivileges=yes
PrivateTmp=yes
# Nothing writes outside PrivateTmp: the release is read-only, its bytecode compiled
# at build. Nothing reads /home: the release is under /srv.
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
