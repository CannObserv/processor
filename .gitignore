# Secrets: dev/agent tokens. Production secrets live in /etc/processor/.env.
.env
.env.*

# The retired cannobserv wheelhouse (#121): nothing reads it, but the deploy checkout
# keeps its files for a rollback past #121 (docs/DEPLOYMENT.md § Rollback). No
# trailing slash: an older worktree may link it, and a symlink is not a directory.
.wheelhouse

# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Machine-local Claude Code settings.
.claude/settings.local.json

# Git worktrees: the using-git-worktrees scripts resolve to .worktrees/; the Claude
# Code harness (isolation: "worktree") provisions into .claude/worktrees/.
.worktrees/
.claude/worktrees/
